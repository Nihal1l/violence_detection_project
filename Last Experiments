":["##  5: Uniform Sampling\n","\n","def uniform_sampling(frame_list, sequence_length=20):\n","\n","\n","    total = len(frame_list)\n","    \n","    if total >= sequence_length:\n","    \n","        indices = np.linspace(\n","            0,\n","            total - 1,\n","            sequence_length\n","        ).astype(int)\n","    \n","        sampled_frames = [\n","            frame_list[i]\n","            for i in indices\n","        ]\n","    \n","    else:\n","    \n","        sampled_frames = frame_list.copy()\n","    \n","        while len(sampled_frames) < sequence_length:\n","            sampled_frames.append(\n","                sampled_frames[-1]\n","            )\n","    \n","    return sampled_frames"]},{"cell_type":"markdown","id":"2b7d9513","metadata":{"papermill":{"duration":0.001714,"end_time":"2026-06-24T14:16:12.469532+00:00","exception":false,"start_time":"2026-06-24T14:16:12.467818+00:00","status":"completed"},"tags":[]},"source":["##  6: Explanation \n","\n","# Uniform Frame Sampling\n","\n","The model expects exactly 20 frames from every video.\n","\n","If a video contains more than 20 frames:\n","\n","* Select 20 equally spaced frames.\n","\n","If a video contains fewer than 20 frames:\n","\n","* Repeat the last frame until 20 frames are available.\n","\n","This ensures a fixed-length temporal sequence for the BiLSTM."]},{"cell_type":"code","execution_count":4,"id":"383d1cd2","metadata":{"execution":{"iopub.execute_input":"2026-06-24T14:16:12.474079Z","iopub.status.busy":"2026-06-24T14:16:12.473584Z","iopub.status.idle":"2026-06-24T14:16:12.549264Z","shell.execute_reply":"2026-06-24T14:16:12.548631Z"},"papermill":{"duration":0.079373,"end_time":"2026-06-24T14:16:12.55058+00:00","exception":false,"start_time":"2026-06-24T14:16:12.471207+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["train/nonviolence: 401 videos\n","train/violence: 500 videos\n","val/nonviolence: 300 videos\n","val/violence