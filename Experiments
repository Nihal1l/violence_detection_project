     ])\n\n        violence_path = os.path.join(root_dir, \"violence\")\n        if os.path.exists(violence_path):\n            for video_folder in sorted(os.listdir(violence_path)):\n                video_path = os.path.join(violence_path, video_folder)\n                if os.path.isdir(video_path):\n                    self.samples.append((video_path, 1))\n\n        nonviolence_path = os.path.join(root_dir, \"nonviolence\")\n        if os.path.exists(nonviolence_path):\n            for video_folder in sorted(os.listdir(nonviolence_path)):\n                video_path = os.path.join(nonviolence_path, video_folder)\n                if os.path.isdir(video_path):\n                    self.samples.append((video_path, 0))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        video_path, label = self.samples[idx]\n        frame_files = sorted(os.listdir(video_path))\n        frames = []\n\n        for frame_name in frame_files:\n            frame_path = os.path.join(video_path, frame_name)\n            try:\n                image = Image.open(frame_path).convert(\"RGB\")\n                image = self.transform(image)\n                frames.append(image)\n            except:\n                continue\n\n        seq_len = self.sequence_length\n        total = len(frames)\n\n        if total == 0:\n            dummy = torch.zeros((3, 224, 224))\n            frames = [dummy for _ in range(seq_len)]\n        elif total >= seq_len:\n            indices = np.linspace(0, total - 1, seq_len).astype(int)\n            frames = [frames[i] for i in indices]\n        else:\n            pad = [frames[-1]] * (seq_len - total)\n            frames = frames + pad\n\n        frames_tensor = torch.stack(frames)\n        label_tensor = torch.tensor(label, dtype=torch.long)\n        return frames_tensor, label_tensor\n'''\nwith open('/kaggle/working/dataset_loader.py', 'w') as f:\n    f.write(code)\nprint(\"Done!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"code = '''import os\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import roc_auc_score\nfrom dataset_loader import ViolenceDataset\nfrom models.violence_model import ViolenceDetectionModel\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device:\", device)\n\ntrain_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/train\",\n    sequence_length=20\n)\nval_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/val\",\n    sequence_length=20\n)\n\nprint(\"Train Samples:\", len(train_dataset))\nprint(\"Validation Samples:\", len(val_dataset))\n\ntrain_loader = DataLoader(train_dataset, batch_size=4, shuffle=True)\nval_loader   = DataLoader(val_dataset,   batch_size=4, shuffle=False)\n\nmodel     = ViolenceDetectionModel().to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=0.0001)\n\nepochs        = 30\nbest_accuracy = 0\n\ntrain_loss_history = []\ntrain_acc_history  = []\nval_acc_history    = []\nval_auc_history    = []\n\nfor epoch in range(epochs):\n    model.train()\n    total_loss    = 0\n    train_correct = 0\n    train_total   = 0\n\n    for frames, labels in train_loader:\n        frames = frames.to(device)\n        labels = labels.to(device)\n        optimizer.zero_grad()\n        outputs = model(frames)\n        loss    = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        total_loss    += loss.item() * labels.size(0)\n        _, predicted   = torch.max(outputs, 1)\n        train_total   += labels.size(0)\n        train_correct += (predicted == labels).sum().item()\n\n    train_accuracy = 100 * train_correct / train_total\n    epoch_loss     = total_loss / train_total\n    train_loss_history.append(epoch_loss)\n    train_acc_history.append(train_accuracy)\n\n    model.eval()\n    correct    = 0\n    total      = 0\n    all_probs  = []\n    all_labels = []\n\n    with torch.no_grad():\n        for frames, labels in val_loader:\n            frames = frames.to(device)\n            labels = labels.to(device)\n            outputs = model(frames)\n            probs   = torch.softmax(outputs, dim=1)[:, 1]\n            all_probs.extend(probs.cpu().numpy())\n            all_labels.extend(labels.cpu().numpy())\n            _, predicted = torch.max(outputs, 1)\n            total   += labels.size(0)\n            correct += (predicted == labels).sum().item()\n\n    val_accuracy = 100 * correct / total\n    try:\n        val_auc = roc_auc_score(all_labels, all_probs)\n    except:\n        val_auc = 0.0\n\n    val_acc_history.append(val_accuracy)\n    val_auc_history.append(val_auc)\n\n    print(f\"Epoch [{epoch+1}/{epochs}] | Loss: {epoch_loss:.4f} | Train: {train_accuracy:.2f}% | Val: {val_accuracy:.2f}% | AUC: {val_auc:.4f}\")\n\n    if val_accuracy > best_accuracy:\n        best_accuracy = val_accuracy\n        torch.save(model.state_dict(), \"results/best_model.pth\")\n        print(f\"Best model saved ({best_accuracy:.2f}%)\")\n\nprint(\"\\\\n\" + \"=\" * 60)\nprint(\"TRAINING SUMMARY\")\nprint(\"=\" * 60)\nfor i in range(epochs):\n    print(f\"Epoch {i+1:02d} | Loss={train_loss_history[i]:.4f} | TrainAcc={train_acc_history[i]:.2f}% | ValAcc={val_acc_history[i]:.2f}% | AUC={val_auc_history[i]:.4f}\")\n\nprint(\"\\\\nBest Validation Accuracy:\", f\"{best_accuracy:.2f}%\")\nprint(\"Training Finished!\")\n'''\nwith open('/kaggle/working/train.py', 'w') as f:\n    f.write(code)\nprint(\"Done!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"code = '''import torch\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix\nfrom dataset_loader import ViolenceDataset\nfrom models.violence_model import ViolenceDetectionModel\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Using device:\", device)\n\ntest_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/test\",\n    sequence_length=20\n)\ntest_loader = DataLoader(test_dataset, batch_size=4, shuffle=False)\n\nmodel = ViolenceDetectionModel()\nmodel.load_state_dict(torch.load(\"results/best_model.pth\", map_location=device))\nmodel = model.to(device)\nmodel.eval()\n\nall_labels      = []\nall_predictions = []\n\nwith torch.no_grad():\n    for frames, labels in test_loader:\n        frames  = frames.to(device)\n        outputs = model(frames)\n        _, predicted = torch.max(outputs, 1)\n        all_labels.extend(labels.numpy())\n        all_predictions.extend(predicted.cpu().numpy())\n\naccuracy  = accuracy_score(all_labels,  all_predictions)\nprecision = precision_score(all_labels, all_predictions)\nrecall    = recall_score(all_labels,    all_predictions)\nf1        = f1_score(all_labels,        all_predictions)\ncm        = confusion_matrix(all_labels, all_predictions)\n\nprint(\"\\\\nResults\")\nprint(\"-\" * 30)\nprint(f\"Accuracy  : {accuracy:.4f}\")\nprint(f\"Precision : {precision:.4f}\")\nprint(f\"Recall    : {recall:.4f}\")\nprint(f\"F1 Score  : {f1:.4f}\")\nprint(\"\\\\nConfusion Matrix\")\nprint(cm)\n\nwith open(\"results/experiment4_metrics.txt\", \"w\") as f:\n    f.write(f\"Accuracy  : {accuracy:.4f}\\\\n\")\n    f.write(f\"Precision : {precision:.4f}\\\\n\")\n    f.write(f\"Recall    : {recall:.4f}\\\\n\")\n    f.write(f\"F1 Score  : {f1:.4f}\\\\n\")\n\nprint(\"\\\\nSaved to results/experiment4_metrics.txt\")\n'''\nwith open('/kaggle/working/evaluate.py', 'w') as f:\n    f.write(code)\nprint(\"Done!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\n\nfiles = [\n    '/kaggle/working/dataset_loader.py',\n    '/kaggle/working/train.py',\n    '/kaggle/working/evaluate.py',\n    '/kaggle/working/models/violence_model.py',\n    '/kaggle/working/models/bilstm_model.py',\n    '/kaggle/working/models/resnet_feature_extractor.py',\n    '/kaggle/working/models/__init__.py',\n    '/kaggle/working/results',\n]\n\nall_ok = True\nfor f in files:\n    status = \"OK     \" if os.path.exists(f) else \"MISSING\"\n    print(f\"{status} → {f}\")\n    if \"MISSING\" in status:\n        all_ok = False\n\nprint()\nprint(\"Ready to train!\" if all_ok else \"Fix missing files before training!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"code","source":"import os\nos.chdir('/kaggle/working')\n!python train.py","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"code = '''import os\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import roc_auc_score\nfrom dataset_loader import ViolenceDataset\nfrom models.violence_model import ViolenceDetectionModel\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device:\", device)\n\ntrain_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/train\",\n    sequence_length=20\n)\nval_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/val\",\n    sequence_length=20\n)\n\nprint(\"Train Samples:\", len(train_dataset))\nprint(\"Validation Samples:\", len(val_dataset))\n\ntrain_loader = DataLoader(train_dataset, batch_size=4, shuffle=True)\nval_loader   = DataLoader(val_dataset,   batch_size=4, shuffle=False)\n\nmodel     = ViolenceDetectionModel().to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=0.0001)\n\n# Learning rate scheduler — reduces LR when val accuracy stops improving\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n    optimizer,\n    mode=\"max\",\n    factor=0.5,\n    patience=3,\n    verbose=True\n)\n\nepochs        = 40\nbest_accuracy = 0\n\ntrain_loss_history = []\ntrain_acc_history  = []\nval_acc_history    = []\nval_auc_history    = []\n\nfor epoch in range(epochs):\n    model.train()\n    total_loss    = 0\n    train_correct = 0\n    train_total   = 0\n\n    for frames, labels in train_loader:\n        frames = frames.to(device)\n        labels = labels.to(device)\n        optimizer.zero_grad()\n        outputs = model(frames)\n        loss    = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        total_loss    += loss.item() * labels.size(0)\n        _, predicted   = torch.max(outputs, 1)\n        train_total   += labels.size(0)\n        train_correct += (predicted == labels).sum().item()\n\n    train_accuracy = 100 * train_correct / train_total\n    epoch_loss     = total_loss / train_total\n    train_loss_history.append(epoch_loss)\n    train_acc_history.append(train_accuracy)\n\n    model.eval()\n    correct    = 0\n    total      = 0\n    all_probs  = []\n    all_labels = []\n\n    with torch.no_grad():\n        for frames, labels in val_loader:\n            frames = frames.to(device)\n            labels = labels.to(device)\n            outputs = model(frames)\n            probs   = torch.softmax(outputs, dim=1)[:, 1]\n            all_probs.extend(probs.cpu().numpy())\n            all_labels.extend(labels.cpu().numpy())\n            _, predicted = torch.max(outputs, 1)\n            total   += labels.size(0)\n            correct += (predicted == labels).sum().item()\n\n    val_accuracy = 100 * correct / total\n    try:\n        val_auc = roc_auc_score(all_labels, all_probs)\n    except:\n        val_auc = 0.0\n\n    val_acc_history.append(val_accuracy)\n    val_auc_history.append(val_auc)\n\n    # Step scheduler based on val accuracy\n    scheduler.step(val_accuracy)\n\n    print(f\"Epoch [{epoch+1}/{epochs}] | Loss: {epoch_loss:.4f} | Train: {train_accuracy:.2f}% | Val: {val_accuracy:.2f}% | AUC: {val_auc:.4f}\")\n\n    if val_accuracy > best_accuracy:\n        best_accuracy = val_accuracy\n        torch.save(model.state_dict(), \"results/best_model.pth\")\n        print(f\"Best model saved ({best_accuracy:.2f}%)\")\n\nprint(\"\\\\n\" + \"=\" * 60)\nprint(\"TRAINING SUMMARY\")\nprint(\"=\" * 60)\nfor i in range(epochs):\n    print(f\"Epoch {i+1:02d} | Loss={train_loss_history[i]:.4f} | TrainAcc={train_acc_history[i]:.2f}% | ValAcc={val_acc_history[i]:.2f}% | AUC={val_auc_history[i]:.4f}\")\n\nprint(\"\\\\nBest Validation Accuracy:\", f\"{best_accuracy:.2f}%\")\nprint(\"Training Finished!\")\n'''\n\nwith open('/kaggle/working/train.py', 'w') as f:\n    f.write(code)\nprint(\"train.py updated — Experiment 5 ready!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!python evaluate.py","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nos.makedirs('/kaggle/working/models', exist_ok=True)\nos.makedirs('/kaggle/working/results', exist_ok=True)\nos.chdir('/kaggle/working')\nprint(\"Working directory:\", os.getcwd())\nprint(\"Folders created!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"resnet_code = '''import torch\nimport torch.nn as nn\nimport torchvision.models as models\n\nclass ResNet18FeatureExtractor(nn.Module):\n    def __init__(self, pretrained=True):\n        super(ResNet18FeatureExtractor, self).__init__()\n        resnet = models.resnet18(pretrained=pretrained)\n        self.feature_extractor = nn.Sequential(*list(resnet.children())[:-1])\n        for param in self.feature_extractor.parameters():\n            param.requires_grad = False\n\n    def forward(self, x):\n        features = self.feature_extractor(x)\n        features = features.view(features.size(0), -1)\n        return features\n'''\n\nbilstm_code = '''import torch\nimport torch.nn as nn\n\nclass BiLSTMClassifier(nn.Module):\n    def __init__(self, input_size=512, hidden_size=256, num_layers=2, num_classes=2):\n        super().__init__()\n        self.lstm = nn.LSTM(\n            input_size=input_size,\n            hidden_size=hidden_size,\n            num_layers=num_layers,\n            batch_first=True,\n            bidirectional=True\n        )\n        self.dropout = nn.Dropout(0.5)\n        self.fc = nn.Linear(hidden_size * 2, num_classes)\n\n    def forward(self, x):\n        lstm_out, _ = self.lstm(x)\n        output = lstm_out[:, -1, :]\n        output = self.dropout(output)\n        output = self.fc(output)\n        return output\n'''\n\nviolence_model_code = '''import torch\nimport torch.nn as nn\nfrom models.resnet_feature_extractor import ResNet18FeatureExtractor\nfrom models.bilstm_model import BiLSTMClassifier\n\nclass ViolenceDetectionModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.feature_extractor = ResNet18FeatureExtractor()\n        self.sequence_model = BiLSTMClassifier()\n\n    def forward(self, x):\n        batch_size, seq_len, c, h, w = x.size()\n        x = x.view(batch_size * seq_len, c, h, w)\n        features = self.feature_extractor(x)\n        features = features.view(batch_size, seq_len, -1)\n        output = self.sequence_model(features)\n        return output\n'''\n\nwith open('/kaggle/working/models/resnet_feature_extractor.py', 'w') as f:\n    f.write(resnet_code)\nwith open('/kaggle/working/models/bilstm_model.py', 'w') as f:\n    f.write(bilstm_code)\nwith open('/kaggle/working/models/violence_model.py', 'w') as f:\n    f.write(violence_model_code)\nwith open('/kaggle/working/models/__init__.py', 'w') as f:\n    f.write('')\n\nprint(\"All model files written!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"loader_code = '''import os\nimport numpy as np\nfrom PIL import Image, ImageEnhance\nimport torch\nfrom torch.utils.data import Dataset