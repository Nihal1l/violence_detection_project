all    = recall_score(all_labels,    all_predictions)\nf1        = f1_score(all_labels,        all_predictions)\ncm        = confusion_matrix(all_labels, all_predictions)\n\nprint(\"\\\\nResults\")\nprint(\"-\" * 30)\nprint(f\"Accuracy  : {accuracy:.4f}\")\nprint(f\"Precision : {precision:.4f}\")\nprint(f\"Recall    : {recall:.4f}\")\nprint(f\"F1 Score  : {f1:.4f}\")\nprint(\"\\\\nConfusion Matrix\")\nprint(cm)\n\nwith open(\"results/experiment6_metrics.txt\", \"w\") as f:\n    f.write(f\"Accuracy  : {accuracy:.4f}\\\\n\")\n    f.write(f\"Precision : {precision:.4f}\\\\n\")\n    f.write(f\"Recall    : {recall:.4f}\\\\n\")\n    f.write(f\"F1 Score  : {f1:.4f}\\\\n\")\nprint(\"\\\\nSaved to results/experiment6_metrics.txt\")\n''')\n\nprint(\"train.py and evaluate.py written!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\n\nfiles = [\n    'dataset_loader.py', 'train.py', 'evaluate.py',\n    'models/violence_model.py', 'models/bilstm_model.py',\n    'models/resnet_feature_extractor.py', 'models/__init__.py',\n    'results'\n]\n\nall_ok = True\nfor f in files:\n    status = \"OK     \" if os.path.exists(f) else \"MISSING\"\n    print(f\"{status} → {f}\")\n    if \"MISSING\" in status:\n        all_ok = False\n\nprint()\nif all_ok:\n    print(\"All files OK — starting training!\")\n    os.system(\"c\")\nelse:\n    print(\"Fix missing files before training!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"code = '''import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass BiLSTMClassifier(nn.Module):\n\n    def __init__(\n        self,\n        input_size=512,\n        hidden_size=256,\n        num_layers=2,\n        num_classes=2\n    ):\n        super().__init__()\n\n        self.lstm = nn.LSTM(\n            input_size=input_size,\n            hidden_size=hidden_size,\n            num_layers=num_layers,\n            batch_first=True,\n            bidirectional=True\n        )\n\n        # Attention layer\n        self.attention = nn.Linear(hidden_size * 2, 1)\n\n        self.dropout = nn.Dropout(0.5)\n        self.fc = nn.Linear(hidden_size * 2, num_classes)\n\n    def forward(self, x):\n\n        # x: (batch, seq_len, input_size)\n        lstm_out, _ = self.lstm(x)\n        # lstm_out: (batch, seq_len, hidden_size*2)\n\n        # Compute attention scores\n        attn_weights = self.attention(lstm_out)\n        # attn_weights: (batch, seq_len, 1)\n\n        attn_weights = F.softmax(attn_weights, dim=1)\n        # attn_weights: (batch, seq_len, 1)\n\n        # Weighted sum of lstm outputs\n        context = torch.sum(attn_weights * lstm_out, dim=1)\n        # context: (batch, hidden_size*2)\n\n        output = self.dropout(context)\n        output = self.fc(output)\n\n        return output\n'''\n\nwith open('/kaggle/working/models/bilstm_model.py', 'w') as f:\n    f.write(code)\n\nprint(\"Attention BiLSTM written successfully!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"with open('/kaggle/working/models/bilstm_model.py', 'r') as f:\n    print(f.read())","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import sys\nsys.path.insert(0, '/kaggle/working')\n\nimport torch\nfrom models.violence_model import ViolenceDetectionModel\n\nmodel = ViolenceDetectionModel()\n\n# Simulate one batch\ndummy_input = torch.zeros(2, 20, 3, 224, 224)\noutput = model(dummy_input)\n\nprint(\"Output shape :\", output.shape)  # should be [2, 2]\nprint(\"Attention model working correctly!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nos.chdir('/kaggle/working')\n!python train.py","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"!python evaluate.py","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_