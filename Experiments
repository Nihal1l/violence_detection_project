mport ResNet18FeatureExtractor\nfrom models.bilstm_model import BiLSTMClassifier\n\n\nclass ViolenceDetectionModel(nn.Module):\n\n    def __init__(self):\n        super().__init__()\n        self.feature_extractor = ResNet18FeatureExtractor()\n        self.sequence_model = BiLSTMClassifier()\n\n    def forward(self, x):\n        batch_size, seq_len, c, h, w = x.size()\n        x = x.view(batch_size * seq_len, c, h, w)\n        features = self.feature_extractor(x)\n        features = features.view(batch_size, seq_len, -1)\n        output = self.sequence_model(features)\n        return output\n'''\n\nwith open('/kaggle/working/models/violence_model.py', 'w') as f:\n    f.write(code)\n\nwith open('/kaggle/working/models/__init__.py', 'w') as f:\n    f.write('')\n\nprint(\"violence_model.py done!\")\nprint(\"__init__.py done!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-10T07:39:56.98351Z","iopub.execute_input":"2026-06-10T07:39:56.983799Z","iopub.status.idle":"2026-06-10T07:39:56.988099Z","shell.execute_reply.started":"2026-06-10T07:39:56.983784Z","shell.execute_reply":"2026-06-10T07:39:56.987112Z"}},"outputs":[{"name":"stdout","text":"violence_model.py done!\n__init__.py done!\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"code = '''import os\nimport numpy as np\nfrom PIL import Image, ImageEnhance\nimport torch\nfrom torch.utils.data import Dataset\nfrom torchvision import transforms\n\n\nclass ViolenceDataset(Dataset):\n\n    def __init__(self, root_dir, sequence_length=20):\n        self.root_dir = root_dir\n        self.sequence_length = sequence_length\n        self.samples = []\n\n        self.transform = transforms.Compose([\n            transforms.Resize((224, 224)),\n            transforms.Lambda(lambda img: ImageEnhance.Sharpness(img).enhance(1.5)),\n            transforms.RandomHorizontalFlip(p=0.5),\n            transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.3),\n            transforms.ToTensor()\n        ])\n\n        violence_path = os.path.join(root_dir, \"violence\")\n        if os.path.exists(violence_path):\n            for video_folder in sorted(os.listdir(violence_path)):\n                video_path = os.path.join(violence_path, video_folder)\n                if os.path.isdir(video_path):\n                    self.samples.append((video_path, 1))\n\n        nonviolence_path = os.path.join(root_dir, \"nonviolence\")\n        if os.path.exists(nonviolence_path):\n            for video_folder in sorted(os.listdir(nonviolence_path)):\n                video_path = os.path.join(nonviolence_path, video_folder)\n                if os.path.isdir(video_path):\n                    self.samples.append((video_path, 0))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        video_path, label = self.samples[idx]\n        frame_files = sorted(os.listdir(video_path))\n        frames = []\n\n        for frame_name in frame_files:\n            frame_path = os.path.join(video_path, frame_name)\n            try:\n                image = Image.open(frame_path).convert(\"RGB\")\n                image = self.transform(image)\n                frames.append(image)\n            except:\n                continue\n\n        seq_len = self.sequence_length\n        total = len(frames)\n\n        if total == 0:\n            dummy = torch.zeros((3, 224, 224))\n            frames = [dummy for _ in range(seq_len)]\n        elif total >= seq_len:\n            indices = np.linspace(0, total - 1, seq_len).astype(int)\n            frames = [frames[i] for i in indices]\n        else:\n            pad = [frames[-1]] * (seq_len - total)\n            frames = frames + pad\n\n        frames_tensor = torch.stack(frames)\n        label_tensor = torch.tensor(label, dtype=torch.long)\n\n        return frames_tensor, label_tensor\n'''\n\nwith open('/kaggle/working/dataset_loader.py', 'w') as f:\n    f.write(code)\nprint(\"dataset_loader.py done!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-10T07:40:02.00158Z","iopub.execute_input":"2026-06-10T07:40:02.001891Z","iopub.status.idle":"2026-06-10T07:40:02.006709Z","shell.execute_reply.started":"2026-06-10T07:40:02.001875Z","shell.execute_reply":"2026-06-10T07:40:02.005775Z"}},"outputs":[{"name":"stdout","text":"dataset_loader.py done!\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"code = '''import os\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import roc_auc_score\nimport matplotlib.pyplot as plt\nfrom dataset_loader import ViolenceDataset\nfrom models.violence_model import ViolenceDetectionModel\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device:\", device)\n\ntrain_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/train\",\n    sequence_length=20\n)\nval_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/val\",\n    sequence_length=20\n)\n\nprint(\"Train Samples:\", len(train_dataset))\nprint(\"Validation Samples:\", len(val_dataset))\n\ntrain_loader = DataLoader(train_dataset, batch_size=4, shuffle=True)\nval_loader   = DataLoader(val_dataset,   batch_size=4, shuffle=False)\n\nmodel     = ViolenceDetectionModel().to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=0.00005)\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode=\"max\", patience=5, factor=0.5)\n\nepochs        = 30\nbest_accuracy = 0\n\ntrain_loss_history = []\ntrain_acc_history  = []\nval_acc_history    = []\nval_auc_history    = []\n\nfor epoch in range(epochs):\n\n    model.train()\n    total_loss    = 0\n    train_correct = 0\n    train_total   = 0\n\n    for frames, labels in train_loader:\n        frames = frames.to(device)\n        labels = labels.to(device)\n        optimizer.zero_grad()\n        outputs = model(frames)\n        loss    = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        total_loss    += loss.item() * labels.size(0)\n        _, predicted   = torch.max(outputs, 1)\n        train_total   += labels.size(0)\n        train_correct += (predicted == labels).sum().item()\n\n    train_accuracy = 100 * train_correct / train_total\n    epoch_loss     = total_loss / train_total\n    train_loss_history.append(epoch_loss)\n    train_acc_history.append(train_accuracy)\n\n    model.eval()\n    correct    = 0\n    total      = 0\n    all_probs  = []\n    all_labels = []\n\n    with torch.no_grad():\n        for frames, labels in val_loader:\n            frames = frames.to(device)\n            labels = labels.to(device)\n            outputs = model(frames)\n            probs   = torch.softmax(outputs, dim=1)[:, 1]\n            all_probs.extend(probs.cpu().numpy())\n            all_labels.extend(labels.cpu().numpy())\n            _, predicted = torch.max(outputs, 1)\n            total   += labels.size(0)\n            correct += (predicted == labels).sum().item()\n\n    val_accuracy = 100 * correct / total\n\n    try:\n        val_auc = roc_auc_score(all_labels, all_probs)\n    except:\n        val_auc = 0.0\n\n    val_acc_history.append(val_accuracy)\n    val_auc_history.append(val_auc)\n    scheduler.step(val_accuracy)\n\n    print(f\"Epoch [{epoch+1}/{epochs}] | Loss: {epoch_loss:.4f} | Train: {train_accuracy:.2f}% | Val: {val_accuracy:.2f}% | AUC: {val_auc:.4f}\")\n\n    if val_accuracy > best_accuracy:\n        best_accuracy = val_accuracy\n        torch.save(model.state_dict(), \"results/best_model.pth\")\n        print(f\"Best model saved ({best_accuracy:.2f}%)\")\n\nprint(\"\\\\n\" + \"=\" * 60)\nprint(\"TRAINING SUMMARY\")\nprint(\"=\" * 60)\nfor i in range(epochs):\n    print(f\"Epoch {i+1:02d} | Loss={train_loss_history[i]:.4f} | TrainAcc={train_acc_history[i]:.2f}% | ValAcc={val_acc_history[i]:.2f}% | AUC={val_auc_history[i]:.4f}\")\n\nprint(\"\\\\nBest Validation Accuracy:\", f\"{best_accuracy:.2f}%\")\nprint(\"Training Finished!\")\n'''\n\nwith open('/kaggle/working/train.py', 'w') as f:\n    f.write(code)\nprint(\"train.py done!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-10T07:40:08.354193Z","iopub.execute_input":"2026-06-10T07:40:08.354469Z","iopub.status.idle":"2026-06-10T07:40:08.359207Z","shell.execute_reply.started":"2026-06-10T07:40:08.354443Z","shell.execute_reply":"2026-06-10T07:40:08.358605Z"}},"outputs":[{"name":"stdout","text":"train.py done!\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"code = '''import torch\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix\nfrom dataset_loader import ViolenceDataset\nfrom models.violence_model import ViolenceDetectionModel\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Using device:\", device)\n\ntest_dataset = ViolenceDataset(\n    root_dir=\"/kaggle/input/datasets/nihalcse/violence-dataset/test\",\n    sequence_length=20\n)\ntest_loader = DataLoader(test_dataset, batch_size=4, shuffle=False)\n\nmodel = ViolenceDetectionModel()\nmodel.load_state_dict(torch.load(\"results/best_model.pth\", map_location=device))\nmodel = model.to(device)\nmodel.eval()\n\nall_labels      = []\nall_predictions = []\n\nwith torch.no_grad():\n    for frames, labels in test_loader:\n        frames  = frames.to(device)\n        outputs = model(frames)\n        _, predicted = torch.max(outputs, 1)\n        all_labels.extend(labels.numpy())\n        all_predictions.extend(predicted.cpu().numpy())\n\naccuracy  = accuracy_score(all_labels,  all_predictions)\nprecision = precision_score(all_labels, all_predictions)\nrecall    = recall_score(all_labels,    all_predictions)\nf1        = f1_score(all_labels,        all_predictions)\ncm   