  if 'scheduler' in line and 'ReduceLR' in line:\n            print(f\"Line {i}: {line.rstrip()}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"bilstm_code = '''import torch\nimport torch.nn as nn\n\n\nclass BiLSTMClassifier(nn.Module):\n    def __init__(self, input_size=512, hidden_size=256, num_layers=2, num_classes=2):\n        super().__init__()\n\n        self.lstm = nn.LSTM(\n            input_size=input_size,\n            hidden_size=hidden_size,\n            num_layers=num_layers,\n            batch_first=True,\n            bidirectional=True\n        )\n\n        self.dropout = nn.Dropout(0.5)\n\n        # Attention layer\n        self.attention = nn.Linear(hidden_size * 2, 1)\n\n        self.fc = nn.Linear(hidden_size * 2, num_classes)\n\n    def forward(self, x):\n        # x: (batch, seq_len, input_size)\n        lstm_out, _ = self.lstm(x)\n        # lstm_out: (batch, seq_len, hidden_size*2)\n\n        # Compute attention scores\n        attn_scores = self.attention(lstm_out)\n        # attn_scores: (batch, seq_len, 1)\n\n        attn_weights = torch.softmax(attn_scores, dim=1)\n        # attn_weights: (batch, seq_len, 1)\n\n        # Weighted sum of all timesteps\n        context = torch.sum(attn_weights * lstm_out, dim=1)\n        # context: (batch, hidden_size*2)\n\n        output = self.dropout(context)\n        output = self.fc(output)\n        return output\n'''\n\nwith open('/kaggle/working/models/bilstm_model.py', 'w') as f:\n    f.write(bilstm_code)\nprint(\"bilstm_model.py updated with attention!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nos.makedirs('/kaggle/working/models', exist_ok=True)\nos.makedirs('/kaggle/working/results', exist_ok=True)\nos.chdir('/kaggle/working')\n\n# ── resnet_feature_extractor.py ──────────────────────────\nwith open('models/resnet_feature_extractor.py', 'w') as f:\n    f.write('''import torch\nimport torch.nn as nn\nimport torchvision.models as models\n\nclass ResNet18FeatureExtractor(nn.Module):\n    def __init__(self, pretrained=True):\n        super().__init__()\n        resnet = models.resnet18(pretrained=pretrained)\n        self.feature_extractor = nn.Sequential(*list(resnet.children())[:-1])\n        for param in self.feature_extractor.parameters():\n            param.requires_grad = False\n\n    def forward(self, x):\n        features = self.feature_extractor(x)\n        features = features.view(features.size(0), -1)\n        return features\n''')\n\n# ── bilstm_model.py (WITH ATTENTION) ─────────────────────\nwith open('models/bilstm_model.py', 'w') as f:\n    f.write('''import torch\nimport torch.nn as nn\n\nclass BiLSTMClassifier(nn.Module):\n    def __init__(self, input_size=512, hidden_size=256, num_layers=2, num_classes=2):\n        super().__init__()\n        self.lstm = nn.LSTM(\n            input_size=input_size,\n            hidden_size=hidden_size,\n            num_layers=num_layers,\n            batch_first=True,\n            bidirectional=True\n        )\n        self.dropout  = nn.Dropout(0.5)\n        self.attention = nn.Linear(hidden_size * 2, 1)\n        self.fc       = nn.Linear(hidden_size * 2, num_classes)\n\n    def forward(self, x):\n        lstm_out, _  = self.lstm(x)\n        attn_scores  = self.attention(lstm_out)\n        attn_weights = torch.softmax(attn_scores, dim=1)\n        context      = torch.sum(attn_weights * lstm_out, dim=1)\n        output       = self.dropout(context)\n        output       = self.fc(output)\n        return output\n''')\n\n# ── violence_model.py ─────────────────────────────────────\nwith open('models/violence_model.py', 'w') as f:\n    f.write('''import torch\nimport torch.nn as nn\nfrom models.resnet_feature_extractor import ResNet18FeatureExtractor\nfrom models.bilstm_model import BiLSTMClassifier\n\nclass ViolenceDetectionModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.feature_extractor = ResNet18FeatureExtractor()\n        self.sequence_model    = BiLSTMClassifier()\n\n    def forward(self, x):\n        batch_size, seq_len, c, h, w = x.size()\n        x        = x.view(batch_size * seq_len, c, h, w)\n        features = self.feature_extractor(x)\n        features = features.view(batch_size, seq_len, -1)\n        output   = self.sequence_model(features)\n        return output\n''')\n\n# ── models/__init__.py ────────────────────────────────────\nwith open('models/__init__.py', 'w') as f:\n    f.write('')\n\n# ── dataset_loader.py ─────────────────────────────────────\nwith open('dataset_loader.py', 'w') as f:\n    f.write('''import os\nimport numpy as np\nfrom PIL import Image, ImageEnhance\nimport torch\nfrom torch.utils.data import Dataset\nfrom torchvision import transforms\n\nclass ViolenceDataset(Dataset):\n    def __init__(self, root_dir, sequence_length=20):\n        self.root_dir        = root_dir\n        self.sequence_length = sequence_length\n        self.samples         = []\n\n        self.transform = transforms.Compose([\n            transforms.Resize((224, 224)),\n            transforms.Lambda(lambda img: ImageEnhance.Sharpness(img).enhance(1.5)),\n            transforms.RandomHorizontalFlip(p=0.5),\n            transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.3),\n            transforms.ToTensor()\n        ])\n\n        for label, folder in [(1, \"violence\"), (0, \"nonviolence\")]:\n            path = os.path.join(root_dir, folder)\n            if os.path.exists(path):\n                for vf in sorted(os.listdir(path)):\n                    vp = os.path.join(path, vf)\n                    if os.path.isdir(vp):\n                        self.samples.append((vp, label))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        video_path, label = self.samples[idx]\n        frames = []\n\n        for frame_name in sorted(os.listdir(video_path))